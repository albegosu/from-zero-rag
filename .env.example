# =============================================================================
# hypar — AI interaction research lab
# Copy to ".env" in the repo root. Docker Compose reads this automatically.
# =============================================================================

# ─── Ollama (agent collaborator) ──────────────────────────────────────────────
# Local mode:
OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2

# Cloud mode (uncomment and set API key):
# LLM_PROVIDER=ollama-cloud
# OLLAMA_URL=https://ollama.com
# OLLAMA_API_KEY=
# OLLAMA_LLM_MODEL=kimi-k2.7-code:cloud

OLLAMA_CHAT_TIMEOUT_MS=180000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://hypar:hypar_local@localhost:5432/hypar

# PostgreSQL container (docker-compose only):
POSTGRES_USER=hypar
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=hypar

# ─── Auth (better-auth) ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME_RANDOM_SECRET
AUTH_SECRET=CHANGE_ME_RANDOM_SECRET
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth (optional) — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (optional) — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Docker Compose (optional) ────────────────────────────────────────────────
# COMPOSE_PROFILES=full

# ─── Public URLs ──────────────────────────────────────────────────────────────
# NUXT_PUBLIC_DOCS_SITE_URL=https://albegosu.github.io/hypar/
