{
  "name": "hypar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "hypar — AI interaction research lab built with Nuxt 3",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "generate": "nuxt generate",
    "prepare": "husky",
    "postinstall": "nuxt prepare && prisma generate",
    "ci:check": "pnpm lint && pnpm typecheck && pnpm test && SKIP_ENV_VALIDATION=true pnpm build",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "demo:poster": "npx -p playwright@1.49.0 node scripts/capture-demo-poster.mjs",
    "release": "changelogen --release"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.58",
    "@ai-sdk/vue": "^3.0.174",
    "@nuxt/icon": "^1.15.0",
    "@nuxt/ui": "^3.0.0",
    "@pinia/nuxt": "^0.5.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vueuse/nuxt": "^11.0.0",
    "ai": "^6.0.174",
    "ai-elements-nuxt": "^1.5.0",
    "better-auth": "^1.6.10",
    "pg": "^8.23.0",
    "pinia": "^2.1.7",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.4.5",
    "web-vitals": "^5.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@nuxt/devtools": "latest",
    "@nuxtjs/robots": "^6.1.1",
    "@nuxtjs/sitemap": "^8.2.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "changelogen": "^0.6.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "gsap": "^3.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "nuxt": "^3.15.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.26.0",
    "vitepress": "^1.6.3",
    "vitest": "^2.1.0",
    "vue-tsc": "^3.2.7"
  },
  "keywords": [
    "ai",
    "research",
    "interaction-design",
    "nuxt",
    "llm",
    "embryo"
  ],
  "author": "Alberto González",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.4",
  "lint-staged": {
    "server/**/*.ts": "eslint --fix",
    "tests/**/*.ts": "eslint --fix",
    "scripts/**/*.ts": "eslint --fix"
  }
}
