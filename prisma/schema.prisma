generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Embryo domain ─────────────────────────────────────────────

enum EmbryoState {
  LATENT
  GERMINATING
  GROWING
  MATURE
  FOSSIL
}

enum EventType {
  CREATED
  STATE_CHANGED
  TENSION_ADDED
  TENSION_RESOLVED
  CONNECTION_MADE
  AGENT_QUESTION
  AGENT_SUGGESTION
  USER_RESPONSE
  FOSSIL_PROPOSED
  FOSSILIZED
}

enum EventInitiator {
  USER
  AGENT
  SYSTEM
}

enum ConnectionType {
  REINFORCES
  CONTRADICTS
  EXTENDS
  RESURRECTS
}

enum AgentNoteType {
  OBSERVATION
  PENDING_QUESTION
  PENDING_CONNECTION
  PENDING_FOSSIL
}

enum FossilTrigger {
  USER
  AGENT
}

model Embryo {
  id           String      @id @default(cuid())
  userId       String
  seed         String      // Raw original thought — never edited after creation
  state        EmbryoState @default(LATENT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  fossilizedAt DateTime?
  fossilReason String?     // Required when fossilizing
  fossilBy     FossilTrigger?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events       EmbryoEvent[]
  tensions     Tension[]
  connections  Connection[]  @relation("ConnectionSource")
  connectedTo  Connection[]  @relation("ConnectionTarget")
  agentNotes   AgentNote[]

  @@index([userId, state])
  @@index([userId, createdAt])
}

model EmbryoEvent {
  id          String         @id @default(cuid())
  embryoId    String
  type        EventType
  initiatedBy EventInitiator
  payload     Json?          // Type-specific data (e.g. old/new state, tension id)
  createdAt   DateTime       @default(now())

  embryo      Embryo         @relation(fields: [embryoId], references: [id], onDelete: Cascade)

  @@index([embryoId, createdAt])
}

model Tension {
  id         String         @id @default(cuid())
  embryoId   String
  question   String
  resolved   Boolean        @default(false)
  raisedBy   EventInitiator
  resolvedAt DateTime?
  createdAt  DateTime       @default(now())

  embryo     Embryo         @relation(fields: [embryoId], references: [id], onDelete: Cascade)

  @@index([embryoId, resolved])
}

model Connection {
  id              String         @id @default(cuid())
  sourceId        String
  targetId        String
  type            ConnectionType
  detectedBy      EventInitiator
  confirmedByUser Boolean        @default(false) // Agent-detected connections need user confirmation
  note            String?
  createdAt       DateTime       @default(now())

  source          Embryo         @relation("ConnectionSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target          Embryo         @relation("ConnectionTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
}

model AgentNote {
  id        String        @id @default(cuid())
  embryoId  String
  type      AgentNoteType
  content   String
  dismissed Boolean       @default(false)
  createdAt DateTime      @default(now())

  embryo    Embryo        @relation(fields: [embryoId], references: [id], onDelete: Cascade)

  @@index([embryoId, type])
}

// ── better-auth tables ────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions  Session[]
  accounts  Account[]
  embryos   Embryo[]
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime?
}
